# ============================================================================
# GYMGUIDE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.development or .env.production and replace placeholders
# NEVER commit actual secrets to version control.
# ============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Backend Server Configuration
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# PostgreSQL Database Configuration (Least-Privilege Application User)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gymguide_db
POSTGRES_USER=gymguide_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_2026
DATABASE_URL=postgresql://gymguide_app:CHANGE_ME_STRONG_DB_PASSWORD_2026@postgres:5432/gymguide_db?schema=public

# MinIO Object Storage Configuration (Backend-only credentials; bucket stays private)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY_32_CHARS
MINIO_BUCKET=gymguide-media
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_PRESIGNED_EXPIRY_SEC=900
MEDIA_STREAM_SECRET=CHANGE_ME_64_BYTE_MEDIA_STREAM_HMAC_SECRET
MAX_IMAGE_UPLOAD_MB=10
MAX_VIDEO_UPLOAD_MB=100

# Security & Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
BODY_LIMIT_KB=100

# Authentication & JWT Configuration (Short-lived access + rotating refresh)
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_RANDOM_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_RANDOM_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Admin Account Seed (Optional - used by prisma/seed.js for initial admin setup)
SEED_ADMIN_EMAIL=admin@gymguide.local
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=GymGuide
