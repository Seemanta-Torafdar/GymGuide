# ============================================================================
# GYMGUIDE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.development or .env.production and replace placeholders
# NEVER commit actual secrets to version control.
# ============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Backend Server Configuration
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# PostgreSQL Database Configuration (Least-Privilege Application User)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gymguide_db
POSTGRES_USER=gymguide_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_2026
DATABASE_URL=postgresql://gymguide_app:CHANGE_ME_STRONG_DB_PASSWORD_2026@postgres:5432/gymguide_db?schema=public

# Security & Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
BODY_LIMIT_KB=100

# Authentication & JWT Configuration (Short-lived access + rotating refresh)
JWT_ACCESS_SECRET=CHANGE_ME_64_BYTE_RANDOM_HEX_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_64_BYTE_RANDOM_HEX_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=GymGuide
